{
  "name": "@red2pr/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Red2PR SPA — React 19, TypeScript strict, Vite, and pinned Meta Astryx Design System wrappers",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest --watch=false"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.4",
    "@astryxdesign/theme-neutral": "0.7.4",
    "@red2pr/ts-client": "workspace:*",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-virtual": "3.14.23",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.72.1",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
