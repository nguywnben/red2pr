{
  "schema_version": 1,
  "profile_id": "node-vitest-linux",
  "revision": 1,
  "display_name": "Node 22 LTS + Vitest (Linux Rootless/VM)",
  "ecosystem": "node",
  "platform": "linux/amd64",
  "base_image": "ghcr.io/red2pr/runner-node-vitest-linux",
  "image_digest": "2220c3d4e5f60718293a4b5c6d7e8f90112233445566778899aabbccdd030303",
  "supported_lockfiles": [
    "pnpm-lock.yaml",
    "package-lock.json",
    "yarn.lock"
  ],
  "env_allowlist": [
    "NODE_ENV",
    "PNPM_STORE_DIR",
    "TZ",
    "npm_config_cache",
    "npm_config_ignore_scripts",
    "npm_config_offline"
  ],
  "default_env": {
    "NODE_ENV": "test",
    "PNPM_STORE_DIR": "/dep-cache/pnpm",
    "TZ": "UTC",
    "npm_config_cache": "/dep-cache/npm",
    "npm_config_ignore_scripts": "true",
    "npm_config_offline": "true"
  },
  "requires_isolated_vm_tier": false,
  "requires_admin_opt_in": false,
  "commands": [
    {
      "command_id": "bootstrap-deps",
      "phase": "bootstrap",
      "argv": [
        "pnpm",
        "install",
        "--frozen-lockfile",
        "--offline",
        "--ignore-scripts",
        "--store-dir=/dep-cache/pnpm"
      ],
      "network_egress_allowed": false,
      "description": "Offline frozen-lockfile restore from tenant-scoped read-only store with lifecycle scripts disabled."
    },
    {
      "command_id": "vitest-repro",
      "phase": "reproduce",
      "argv": [
        "npx",
        "--no-install",
        "vitest",
        "run",
        "--no-color",
        "--reporter=verbose"
      ],
      "network_egress_allowed": false,
      "description": "Deterministic Vitest baseline & patched reproduction run."
    },
    {
      "command_id": "vitest-targeted",
      "phase": "test",
      "argv": [
        "npx",
        "--no-install",
        "vitest",
        "run",
        "--no-color"
      ],
      "network_egress_allowed": false,
      "description": "Deterministic Vitest targeted test execution."
    },
    {
      "command_id": "vitest-regression",
      "phase": "test",
      "argv": [
        "npx",
        "--no-install",
        "vitest",
        "run",
        "--no-color"
      ],
      "network_egress_allowed": false,
      "description": "Full Vitest CI regression suite."
    },
    {
      "command_id": "sandbox-self-test",
      "phase": "self_test",
      "argv": [
        "node",
        "-e",
        "process.stdout.write('sandbox-isolated-ok\\n')"
      ],
      "network_egress_allowed": false,
      "description": "Minimal isolated Node guest confinement self-test."
    }
  ]
}
