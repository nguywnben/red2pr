{
  "name": "red2pr-monorepo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Red2PR self-hosted CI repair with proof — frontend & TypeScript client workspace",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "quickstart:web": "pnpm --filter @red2pr/ts-client build && pnpm --filter @red2pr/web build"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.4"
  }
}
