# Preserve POSIX LF line endings for shell scripts, systemd units, and container configs
# even when cloned on Windows with core.autocrlf=true.
*.sh text eol=lf
*.service text eol=lf
Caddyfile text eol=lf

# PowerShell scripts use Windows CRLF
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.woff2 binary
