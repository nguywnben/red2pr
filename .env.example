# Red2PR bootstrap environment template (non-secret placeholders only).
# Never commit real credentials or private keys; use secret references in config.
RED2PR_DEPLOYMENT_MODE=local
RED2PR_PUBLIC_BASE_URL=http://127.0.0.1:4280
RED2PR_HTTP_PORT=4280
RED2PR_DATA_DIR=.local-data/red2pr
RED2PR_CONFIG_FILE=
RED2PR_MASTER_KEY_FILE=
RED2PR_DATABASE_URL_FILE=
