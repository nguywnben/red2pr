[Unit]
Description=Red2PR control plane container
Documentation=https://red2pr.dev/docs/operations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=red2pr
Group=red2pr
Environment=HOME=/var/lib/red2pr
Environment=RED2PR_DATA_DIR=/var/lib/red2pr
ExecStart=/usr/bin/podman start --attach red2pr-control
ExecStop=/usr/bin/podman stop --time=30 red2pr-control
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/red2pr

[Install]
WantedBy=default.target
