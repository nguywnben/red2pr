{
  "$defs": {
    "IsolationCheckResult": {
      "additionalProperties": false,
      "description": "S-21 supervisor-attested confinement/cleanup check result.",
      "properties": {
        "check_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "check_id",
        "passed"
      ],
      "title": "IsolationCheckResult",
      "type": "object"
    },
    "PublicKeyRecord": {
      "additionalProperties": false,
      "description": "Enrolled verification public key metadata retained across rotations (S-22).",
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "default": "ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Key Id",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "public_key_b64": {
          "maxLength": 4096,
          "title": "Public Key B64",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "trust_domain": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust Domain"
        }
      },
      "required": [
        "key_id",
        "public_key_b64",
        "not_before"
      ],
      "title": "PublicKeyRecord",
      "type": "object"
    },
    "ResultArtifactRef": {
      "additionalProperties": false,
      "description": "S-21 content-addressed execution output artifact descriptor.",
      "properties": {
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "size": {
          "minimum": 0,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "digest",
        "size"
      ],
      "title": "ResultArtifactRef",
      "type": "object"
    },
    "ResultV1": {
      "additionalProperties": false,
      "description": "S-21 supervisor-signed sandbox execution outcome (never signed inside guest).",
      "properties": {
        "artifact_refs": {
          "items": {
            "$ref": "#/$defs/ResultArtifactRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "capability_nonce": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Capability Nonce",
          "type": "string"
        },
        "command_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Digest",
          "type": "string"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "environment_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Digest",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "image_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "isolation_checks": {
          "items": {
            "$ref": "#/$defs/IsolationCheckResult"
          },
          "minItems": 1,
          "title": "Isolation Checks",
          "type": "array"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "patch_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch Digest"
        },
        "resource_usage": {
          "$ref": "#/$defs/SandboxResourceUsage"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "signature": {
          "maxLength": 4096,
          "title": "Signature",
          "type": "string"
        },
        "signer_key_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Signer Key Id",
          "type": "string"
        },
        "source_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Digest",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "termination": {
          "enum": [
            "exited",
            "timeout",
            "oom",
            "cancelled",
            "infrastructure_error"
          ],
          "title": "Termination",
          "type": "string"
        },
        "worker_id": {
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "lease_epoch",
        "capability_nonce",
        "worker_id",
        "started_at",
        "ended_at",
        "termination",
        "command_digest",
        "image_digest",
        "environment_digest",
        "source_digest",
        "resource_usage",
        "isolation_checks",
        "signer_key_id",
        "signature"
      ],
      "title": "ResultV1",
      "type": "object"
    },
    "SandboxJobV1": {
      "additionalProperties": false,
      "description": "S-21 lease-fenced immutable execution directive dispatched to worker supervisor.",
      "properties": {
        "artifact_upload_capability": {
          "maxLength": 4096,
          "title": "Artifact Upload Capability",
          "type": "string"
        },
        "base_sha": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Sha",
          "type": "string"
        },
        "capability_nonce": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Capability Nonce",
          "type": "string"
        },
        "command_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Command Ids",
          "type": "array"
        },
        "expected_worker_trust_domain": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Expected Worker Trust Domain",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "image_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Image Digest",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "network_policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Network Policy Digest",
          "type": "string"
        },
        "patch_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Patch Digest"
        },
        "profile_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_revision": {
          "minimum": 1,
          "title": "Profile Revision",
          "type": "integer"
        },
        "repair_id": {
          "title": "Repair Id",
          "type": "string"
        },
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "resource_limits": {
          "$ref": "#/$defs/SandboxResourceLimits"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_archive_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Archive Digest",
          "type": "string"
        },
        "supervisor_policy_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Supervisor Policy Digest",
          "type": "string"
        },
        "workspace_id": {
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "workspace_id",
        "repository_id",
        "repair_id",
        "lease_epoch",
        "capability_nonce",
        "issued_at",
        "expires_at",
        "base_sha",
        "source_archive_digest",
        "profile_id",
        "profile_revision",
        "image_digest",
        "command_ids",
        "resource_limits",
        "network_policy_digest",
        "artifact_upload_capability",
        "expected_worker_trust_domain",
        "supervisor_policy_digest"
      ],
      "title": "SandboxJobV1",
      "type": "object"
    },
    "SandboxResourceLimits": {
      "additionalProperties": false,
      "description": "S-21 hard execution quotas enforced by isolated worker supervisor.",
      "properties": {
        "cpu": {
          "maximum": 64,
          "minimum": 1,
          "title": "Cpu",
          "type": "integer"
        },
        "disk_bytes": {
          "minimum": 1,
          "title": "Disk Bytes",
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 1,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "output_bytes": {
          "minimum": 1,
          "title": "Output Bytes",
          "type": "integer"
        },
        "pids": {
          "maximum": 65536,
          "minimum": 1,
          "title": "Pids",
          "type": "integer"
        },
        "wall_seconds": {
          "maximum": 7200,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        }
      },
      "required": [
        "cpu",
        "memory_bytes",
        "disk_bytes",
        "pids",
        "wall_seconds",
        "output_bytes"
      ],
      "title": "SandboxResourceLimits",
      "type": "object"
    },
    "SandboxResourceUsage": {
      "additionalProperties": false,
      "description": "S-21 measured guest resource consumption.",
      "properties": {
        "disk_written_bytes": {
          "minimum": 0,
          "title": "Disk Written Bytes",
          "type": "integer"
        },
        "max_memory_bytes": {
          "minimum": 0,
          "title": "Max Memory Bytes",
          "type": "integer"
        },
        "output_bytes": {
          "minimum": 0,
          "title": "Output Bytes",
          "type": "integer"
        },
        "wall_ms": {
          "minimum": 0,
          "title": "Wall Ms",
          "type": "integer"
        }
      },
      "required": [
        "wall_ms",
        "max_memory_bytes",
        "disk_written_bytes",
        "output_bytes"
      ],
      "title": "SandboxResourceUsage",
      "type": "object"
    },
    "Worker": {
      "additionalProperties": false,
      "description": "S-15 enrolled isolated sandbox worker supervisor node.",
      "properties": {
        "active_leases": {
          "default": 0,
          "minimum": 0,
          "title": "Active Leases",
          "type": "integer"
        },
        "capabilities": {
          "additionalProperties": {
            "type": "boolean"
          },
          "propertyNames": {
            "maxLength": 120,
            "minLength": 1
          },
          "title": "Capabilities",
          "type": "object"
        },
        "cpu_limit": {
          "default": 4,
          "maximum": 256,
          "minimum": 1,
          "title": "Cpu Limit",
          "type": "integer"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "disk_limit_bytes": {
          "default": 42949672960,
          "minimum": 1,
          "title": "Disk Limit Bytes",
          "type": "integer"
        },
        "drain_reason": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Drain Reason"
        },
        "heartbeat_at": {
          "format": "date-time",
          "title": "Heartbeat At",
          "type": "string"
        },
        "host_escape_warning": {
          "default": false,
          "title": "Host Escape Warning",
          "type": "boolean"
        },
        "host_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host Id"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "isolation_mode": {
          "default": "oci_rootless",
          "enum": [
            "oci_rootless",
            "vm_isolated",
            "oci_trusted_local"
          ],
          "title": "Isolation Mode",
          "type": "string"
        },
        "memory_limit_bytes": {
          "default": 8589934592,
          "minimum": 1,
          "title": "Memory Limit Bytes",
          "type": "integer"
        },
        "mtls_cert_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mtls Cert Expires At"
        },
        "mtls_cert_fingerprint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mtls Cert Fingerprint Sha256"
        },
        "pids_limit": {
          "default": 512,
          "maximum": 65536,
          "minimum": 1,
          "title": "Pids Limit",
          "type": "integer"
        },
        "profile_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "title": "Profile Ids",
          "type": "array"
        },
        "quarantine_reason": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quarantine Reason"
        },
        "runtime_name": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Name"
        },
        "signer_key_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signer Key Id"
        },
        "status": {
          "enum": [
            "online",
            "offline",
            "draining",
            "quarantined"
          ],
          "title": "Status",
          "type": "string"
        },
        "trust_domain": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Trust Domain",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "version",
        "created_at",
        "updated_at",
        "trust_domain",
        "profile_ids",
        "heartbeat_at",
        "status"
      ],
      "title": "Worker",
      "type": "object"
    },
    "WorkerArtifactUploadRequest": {
      "additionalProperties": false,
      "description": "S-21 write-only per-job artifact slot upload payload (`<=100MiB` total output cap).",
      "properties": {
        "capability_nonce": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Capability Nonce",
          "type": "string"
        },
        "content_b64": {
          "maxLength": 140000000,
          "title": "Content B64",
          "type": "string"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "mime": {
          "default": "text/plain",
          "maxLength": 120,
          "minLength": 1,
          "title": "Mime",
          "type": "string"
        },
        "slot_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Slot Name",
          "type": "string"
        }
      },
      "required": [
        "lease_epoch",
        "capability_nonce",
        "slot_name",
        "content_b64",
        "digest"
      ],
      "title": "WorkerArtifactUploadRequest",
      "type": "object"
    },
    "WorkerArtifactUploadResponse": {
      "additionalProperties": false,
      "description": "S-21 verified encrypted artifact upload receipt.",
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ResultArtifactRef"
        },
        "remaining_output_bytes": {
          "minimum": 0,
          "title": "Remaining Output Bytes",
          "type": "integer"
        }
      },
      "required": [
        "artifact_ref",
        "remaining_output_bytes"
      ],
      "title": "WorkerArtifactUploadResponse",
      "type": "object"
    },
    "WorkerCancelAckRequest": {
      "additionalProperties": false,
      "description": "S-21 worker confirmation of guest process teardown and ephemeral cleanup.",
      "properties": {
        "capability_nonce": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Capability Nonce",
          "type": "string"
        },
        "cleanup_verified": {
          "title": "Cleanup Verified",
          "type": "boolean"
        },
        "container_killed": {
          "title": "Container Killed",
          "type": "boolean"
        },
        "ended_at": {
          "format": "date-time",
          "title": "Ended At",
          "type": "string"
        },
        "isolation_checks": {
          "items": {
            "$ref": "#/$defs/IsolationCheckResult"
          },
          "minItems": 1,
          "title": "Isolation Checks",
          "type": "array"
        },
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        }
      },
      "required": [
        "lease_epoch",
        "capability_nonce",
        "ended_at",
        "container_killed",
        "cleanup_verified",
        "isolation_checks"
      ],
      "title": "WorkerCancelAckRequest",
      "type": "object"
    },
    "WorkerCancelAckResponse": {
      "additionalProperties": false,
      "description": "S-21 control-plane receipt for job cancellation acknowledgement.",
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "lease_epoch": {
          "minimum": 1,
          "title": "Lease Epoch",
          "type": "integer"
        },
        "state": {
          "enum": [
            "queued",
            "leased",
            "running",
            "succeeded",
            "failed",
            "cancel_requested",
            "cancelled",
            "dead_letter"
          ],
          "title": "State",
          "type": "string"
        },
        "worker_quarantined": {
          "default": false,
          "title": "Worker Quarantined",
          "type": "boolean"
        }
      },
      "required": [
        "job_id",
        "lease_epoch",
        "state"
      ],
      "title": "WorkerCancelAckResponse",
      "type": "object"
    },
    "WorkerEnrollHandshakeRequest": {
      "additionalProperties": false,
      "description": "S-21 one-time enrollment token + PKCS#10 CSR + Ed25519 public key exchange.",
      "properties": {
        "attestation": {
          "$ref": "#/$defs/WorkerIsolationAttestation"
        },
        "csr_pem": {
          "maxLength": 4096,
          "title": "Csr Pem",
          "type": "string"
        },
        "enrollment_token": {
          "maxLength": 4096,
          "title": "Enrollment Token",
          "type": "string"
        },
        "profile_ids": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Profile Ids",
          "type": "array"
        },
        "signer_public_key": {
          "$ref": "#/$defs/PublicKeyRecord"
        }
      },
      "required": [
        "enrollment_token",
        "csr_pem",
        "signer_public_key",
        "attestation",
        "profile_ids"
      ],
      "title": "WorkerEnrollHandshakeRequest",
      "type": "object"
    },
    "WorkerEnrollHandshakeResponse": {
      "additionalProperties": false,
      "description": "S-21 issued mTLS client certificate, Worker CA bundle, and enrolled Worker record.",
      "properties": {
        "ca_cert_pem": {
          "maxLength": 4096,
          "title": "Ca Cert Pem",
          "type": "string"
        },
        "cert_expires_at": {
          "format": "date-time",
          "title": "Cert Expires At",
          "type": "string"
        },
        "client_cert_pem": {
          "maxLength": 4096,
          "title": "Client Cert Pem",
          "type": "string"
        },
        "worker": {
          "$ref": "#/$defs/Worker"
        }
      },
      "required": [
        "worker",
        "client_cert_pem",
        "ca_cert_pem",
        "cert_expires_at"
      ],
      "title": "WorkerEnrollHandshakeResponse",
      "type": "object"
    },
    "WorkerIsolationAttestation": {
      "additionalProperties": false,
      "description": "S-21 worker supervisor preflight isolation & quota attestation.",
      "properties": {
        "cpu_limit": {
          "maximum": 256,
          "minimum": 1,
          "title": "Cpu Limit",
          "type": "integer"
        },
        "disk_limit_bytes": {
          "minimum": 1,
          "title": "Disk Limit Bytes",
          "type": "integer"
        },
        "host_id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Host Id",
          "type": "string"
        },
        "isolation_mode": {
          "enum": [
            "oci_rootless",
            "vm_isolated",
            "oci_trusted_local"
          ],
